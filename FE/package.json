{
  "name": "sachul-banjang",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "dev:demo": "vite --host 127.0.0.1 --configLoader runner --mode demo",
    "dev:demo:share": "vite --host 0.0.0.0 --configLoader runner --mode demo",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner",
    "dev:tablet": "vite --config vite.tablet.config.ts --configLoader runner",
    "build:tablet": "tsc -p tsconfig.tablet.json && vite build --config vite.tablet.config.ts --configLoader runner",
    "preview:tablet": "vite preview --config vite.tablet.config.ts --configLoader runner"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.5"
  }
}
