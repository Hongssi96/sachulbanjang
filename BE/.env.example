# Local examples only. Copy to .env and fill issued values; never commit .env.
APP_ENV=development

# JSON request logs on stdout: DEBUG, INFO (default), WARNING, ERROR, or CRITICAL.
APP_LOG_LEVEL=INFO

# PostgreSQL 18 local connection. Keep credentials aligned with compose.yaml for development.
APP_DATABASE_URL=postgresql+psycopg://imleader:change-me@localhost:5432/imleader

# Independent random server secret (at least 32 characters). Never reuse an external API key.
APP_JWT_SECRET=replace-with-at-least-32-random-characters

# 인증 기본값: 액세스 15분, 리프레시 최초 로그인부터 7일, 5회 실패 시 5분 잠금
APP_ACCESS_TOKEN_TTL_SECONDS=900
APP_REFRESH_TOKEN_TTL_SECONDS=604800
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_LOCK_SECONDS=300
# 같은 세션의 중복 갱신을 재사용으로 보지 않는 유예(초). 0이면 유예 없음
APP_REFRESH_REUSE_GRACE_SECONDS=10
# API로 발급한 임시 비밀번호의 유효 기간(초). 기본 24시간
APP_TEMPORARY_PASSWORD_TTL_SECONDS=86400
# HTTPS 배포 환경에서는 true로 설정한다.
APP_AUTH_COOKIE_SECURE=false
# FE 개발 서버 출처. 비어 있으면 CORS 미들웨어를 추가하지 않는다.
APP_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# AI settings stay on the backend. If APP_AI_API_KEY is empty, general features remain
# available and AI features are disabled. Include /v1 in the approved compatible base URL.
APP_AI_BASE_URL=https://your-approved-ai-server.example/v1
APP_AI_API_KEY=
APP_AI_MODEL=gpt-6.2-sol
APP_AI_REQUEST_TIMEOUT_SECONDS=120
APP_REPORT_WORKER_LEASE_SECONDS=300
