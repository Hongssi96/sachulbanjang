FROM node:22-slim AS build

RUN corepack enable
WORKDIR /app

COPY FE/package.json FE/pnpm-lock.yaml FE/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY FE/ ./
# 태블릿 번들은 FE 소스를 수정하지 않고 base 경로만 빌드 인자로 바꾼다.
RUN pnpm build \
    && pnpm exec tsc -p tsconfig.tablet.json \
    && pnpm exec vite build --config vite.tablet.config.ts --configLoader runner --base=/tablet/

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /app/dist-tablet /usr/share/nginx/html/tablet
